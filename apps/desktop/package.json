{
	"name": "@rndevtools/desktop",
	"productName": "RN Devtools",
	"version": "0.1.0",
	"private": true,
	"author": "Aren Dalloul",
	"description": "Local-first desktop diagnostics for React Native apps",
	"main": "dist/main/index.js",
	"scripts": {
		"electron:ensure": "node -e \"require('electron')\"",
		"dev": "pnpm electron:ensure && electron-vite dev",
		"dev:simulator": "pnpm native:build && pnpm dev",
		"start": "pnpm electron:ensure && electron-vite preview",
		"build": "electron-vite build",
		"native:build": "node scripts/build-native-helpers.mjs",
		"native:build:all": "node scripts/build-native-helpers.mjs --all",
		"native:build:package": "node scripts/build-native-helpers.mjs --if-supported",
		"native:check": "node scripts/check-native-helpers.mjs && pnpm native:check:packaging",
		"native:check:go": "node scripts/check-native-helpers.mjs --go",
		"native:check:packaging": "node --test scripts/verify-vendored-simslim.node-test.mjs",
		"native:check:swift": "node scripts/check-native-helpers.mjs --swift",
		"native:verify": "node scripts/verify-native-resources.cjs",
		"native:verify:capabilities": "node scripts/verify-native-host-capabilities.mjs",
		"native:verify:cold-start": "node scripts/verify-packaged-cold-start.mjs",
		"package": "pnpm native:build:package && pnpm build && electron-builder --dir",
		"make": "pnpm native:build:package && pnpm build && electron-builder",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit --pretty false -p tsconfig.node.json && tsc --noEmit --pretty false -p tsconfig.renderer.json",
		"check:unused": "knip --directory ../.. --workspace apps/desktop --treat-config-hints-as-errors",
		"check:cycles": "knip --directory ../.. --workspace apps/desktop --cycles --treat-config-hints-as-errors",
		"check:dead-code": "pnpm check:unused && pnpm check:cycles",
		"test:run": "vitest run",
		"quality": "pnpm lint && pnpm typecheck && pnpm check:dead-code && pnpm test:run && pnpm build"
	},
	"dependencies": {},
	"devDependencies": {
		"@rndevtools/core": "workspace:*",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@heroui-pro/react": "1.0.0-beta.8",
		"@heroui/react": "^3.2.4",
		"@heroui/styles": "catalog:",
		"@react-aria/i18n": "^3.13.1",
		"@react-aria/ssr": "^3.10.1",
		"@react-aria/utils": "^3.34.1",
		"lucide-react": "catalog:",
		"motion": "catalog:",
		"react": "catalog:",
		"react-aria": "^3.52.1",
		"react-aria-components": "^1.21.1",
		"react-dom": "catalog:",
		"tailwind-variants": "^3.3.1",
		"@biomejs/biome": "catalog:",
		"@electron/fuses": "^2.1.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "catalog:node24",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "5.1.4",
		"electron": "44.2.0",
		"electron-builder": "^26.15.3",
		"electron-vite": "5.0.0",
		"knip": "catalog:",
		"tailwindcss": "catalog:",
		"tw-animate-css": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"ws": "^8.21.3",
		"zod": "catalog:"
	},
	"build": {
		"appId": "io.github.adalloul0928.rndevtools",
		"productName": "RN Devtools",
		"icon": "build/icon.svg",
		"asar": true,
		"beforeBuild": "scripts/before-build.cjs",
		"afterPack": "scripts/after-pack.cjs",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"!dist/**/*.map",
			"package.json",
			"!node_modules/**/*"
		],
		"mac": {
			"category": "public.app-category.developer-tools",
			"hardenedRuntime": true,
			"signIgnore": [
				"/Contents/Resources/native/rndevtools(?:-sim-helper|-native-host)?$"
			],
			"extraResources": [
				{
					"from": "build/native/mac-${arch}",
					"to": "native",
					"filter": [
						"**/*"
					]
				},
				{
					"from": "THIRD_PARTY_NOTICES.md",
					"to": "THIRD_PARTY_NOTICES.md"
				}
			],
			"target": [
				"dmg",
				"zip"
			]
		},
		"win": {
			"target": [
				"nsis"
			]
		},
		"linux": {
			"category": "Development",
			"target": [
				"AppImage",
				"deb"
			]
		}
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/adalloul0928/rndevtools.git",
		"directory": "apps/desktop"
	},
	"homepage": "https://github.com/adalloul0928/rndevtools/tree/main/apps/desktop#readme",
	"bugs": "https://github.com/adalloul0928/rndevtools/issues"
}
