{
	"name": "@pumpd/devtools-desktop",
	"productName": "PUMPD Devtools",
	"version": "0.1.0",
	"private": true,
	"author": "AVAD Technologies LLC",
	"description": "Local-first desktop diagnostics for PUMPD apps",
	"main": "dist/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"dev:simulator": "pnpm native:build && electron-vite dev",
		"start": "electron-vite preview",
		"build": "electron-vite build",
		"native:build": "node scripts/build-native-helpers.mjs",
		"native:build:all": "node scripts/build-native-helpers.mjs --all",
		"native:build:package": "node scripts/build-native-helpers.mjs --if-supported",
		"native:check": "node scripts/check-native-helpers.mjs && pnpm native:check:packaging",
		"native:check:go": "node scripts/check-native-helpers.mjs --go",
		"native:check:packaging": "node --test scripts/native-packaging.node-test.cjs scripts/verify-vendored-simslim.node-test.mjs",
		"native:check:swift": "node scripts/check-native-helpers.mjs --swift",
		"native:verify": "node scripts/verify-native-resources.cjs",
		"native:verify:capabilities": "node scripts/verify-native-host-capabilities.mjs",
		"native:verify:cold-start": "node scripts/verify-packaged-cold-start.mjs",
		"package": "pnpm native:build:package && pnpm build && electron-builder --dir",
		"make": "pnpm native:build:package && pnpm build && electron-builder",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit --pretty false -p tsconfig.node.json && tsc --noEmit --pretty false -p tsconfig.renderer.json",
		"check:unused": "knip --treat-config-hints-as-errors",
		"check:cycles": "knip --cycles --treat-config-hints-as-errors",
		"check:dead-code": "pnpm check:unused && pnpm check:cycles",
		"test:run": "vitest run",
		"quality": "pnpm lint && pnpm typecheck && pnpm check:dead-code && pnpm test:run && pnpm build"
	},
	"dependencies": {},
	"devDependencies": {
		"@pumpd/devtools": "workspace:*",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@heroui-pro/react": "1.0.0-beta.8",
		"@heroui/react": "^3.2.4",
		"@heroui/styles": "^3.2.4",
		"@react-aria/i18n": "^3.13.1",
		"@react-aria/ssr": "^3.10.1",
		"@react-aria/utils": "^3.34.1",
		"lucide-react": "^1.33.0",
		"motion": "^13.1.1",
		"react": "19.2.3",
		"react-aria": "^3.51.0",
		"react-aria-components": "^1.20.0",
		"react-dom": "19.2.3",
		"tailwind-variants": "^3.3.1",
		"@biomejs/biome": "2.5.10",
		"@electron/fuses": "^2.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "5.1.4",
		"electron": "43.4.1",
		"electron-builder": "26.15.3",
		"electron-vite": "5.0.0",
		"knip": "^6.32.2",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "5.9.2",
		"vite": "7.3.6",
		"vitest": "^4.1.11",
		"ws": "^8.21.3",
		"zod": "^4.3.6"
	},
	"build": {
		"appId": "com.avadtechnologies.pumpd.devtools",
		"productName": "PUMPD Devtools",
		"icon": "build/icon.svg",
		"asar": true,
		"beforeBuild": "scripts/before-build.cjs",
		"afterPack": "scripts/after-pack.cjs",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"!dist/**/*.map",
			"package.json",
			"!node_modules/**/*"
		],
		"mac": {
			"category": "public.app-category.developer-tools",
			"hardenedRuntime": true,
			"signIgnore": [
				"/Contents/Resources/native/pumpd-(?:sim-helper|native-host|devtools)$"
			],
			"extraResources": [
				{
					"from": "build/native/mac-${arch}",
					"to": "native",
					"filter": [
						"**/*"
					]
				},
				{
					"from": "THIRD_PARTY_NOTICES.md",
					"to": "THIRD_PARTY_NOTICES.md"
				}
			],
			"target": [
				"dmg",
				"zip"
			]
		},
		"win": {
			"target": [
				"nsis"
			]
		},
		"linux": {
			"category": "Development",
			"target": [
				"AppImage",
				"deb"
			]
		}
	}
}
