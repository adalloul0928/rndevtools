{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"lib": ["ES2023"],
		"types": ["node"],
		"paths": {
			"@main/*": ["./src/main/*"],
			"@shared/*": ["./src/shared/*"]
		}
	},
	"include": [
		"electron.vite.config.ts",
		"src/*.test.ts",
		"src/main/**/*.ts",
		"src/preload/**/*.ts",
		"src/shared/**/*.ts"
	],
	"exclude": [".vite", "dist", "release"]
}
