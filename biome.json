{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"!**/node_modules",
			"!**/dist",
			"!**/build",
			"!**/release",
			"!**/.turbo"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": false
	}
}
