{
	"name": "@rndevtools/example-expo-demo",
	"version": "0.0.0",
	"private": true,
	"main": "index.ts",
	"scripts": {
		"lint": "biome check src",
		"typecheck": "tsc --noEmit",
		"verify:bundle": "expo export --platform ios --output-dir ./build --no-bytecode && rndevtools-verify-bundle ./build",
		"quality": "pnpm lint && pnpm typecheck && pnpm verify:seam",
		"verify:seam": "node scripts/verify-prune-seam.mjs"
	},
	"dependencies": {
		"@expo/material-symbols": "catalog:",
		"@expo/ui": "catalog:",
		"@rndevtools/core": "workspace:*",
		"@rndevtools/react-native": "workspace:*",
		"@tanstack/react-query": "catalog:",
		"expo": "catalog:",
		"expo-constants": "57.0.18",
		"expo-device": "57.0.2",
		"react": "catalog:",
		"react-native": "catalog:",
		"react-native-gesture-handler": "catalog:",
		"react-native-reanimated": "catalog:",
		"react-native-safe-area-context": "catalog:",
		"react-native-svg": "catalog:",
		"react-native-worklets": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/react": "catalog:",
		"typescript": "catalog:"
	}
}
