{
	"name": "@pumpd/devtools",
	"version": "0.1.0",
	"private": true,
	"description": "Private, extensible on-device diagnostics for Expo and React Native",
	"license": "UNLICENSED",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./desktop-protocol": "./src/desktop-protocol.ts",
		"./format": "./src/core/format.ts",
		"./redact": "./src/core/redact.ts",
		"./scenario-model": "./src/scenario-model.ts",
		"./serialize": "./src/core/serialize.ts",
		"./plugins": "./src/plugins/index.ts",
		"./plugins/images": "./src/plugins/images.tsx",
		"./plugins/storage": "./src/plugins/storage.tsx",
		"./plugins/network-presentation": "./src/plugins/network-presentation.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"lint": "biome check src",
		"typecheck": "tsc --noEmit",
		"check:unused": "knip --directory ../.. --workspace packages/devtools --treat-config-hints-as-errors",
		"check:cycles": "knip --directory ../.. --workspace packages/devtools --cycles --treat-config-hints-as-errors",
		"check:dead-code": "pnpm check:unused && pnpm check:cycles",
		"test:run": "jest --runInBand",
		"test:coverage": "jest --runInBand --coverage",
		"quality": "pnpm lint && pnpm typecheck && pnpm check:dead-code && pnpm test:run"
	},
	"peerDependencies": {
		"@expo/material-symbols": ">=0.1 <1",
		"@expo/ui": ">=57 <58",
		"@tanstack/react-query": ">=5 <6",
		"expo": ">=57 <58",
		"react": ">=19 <20",
		"react-native": ">=0.86 <0.87",
		"react-native-gesture-handler": ">=2.16 <3",
		"react-native-reanimated": ">=4 <5",
		"react-native-safe-area-context": ">=5 <6",
		"react-native-worklets": ">=0.10 <1",
		"react-native-svg": ">=15 <16"
	},
	"peerDependenciesMeta": {
		"@tanstack/react-query": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:biomejs-biome-2-5-10",
		"@expo/material-symbols": "catalog:",
		"@expo/ui": "catalog:expo-ui-57-0-11",
		"@tanstack/react-query": "catalog:tanstack-react-query-5-101-4",
		"@testing-library/react-native": "catalog:testing-library-react-native-13-3-3",
		"@types/jest": "catalog:",
		"@types/react": "catalog:types-react-19-2-18",
		"expo": "catalog:expo-57-0-13",
		"jest": "catalog:",
		"jest-expo": "catalog:jest-expo-57-0-4",
		"knip": "catalog:knip-range-6-32-2",
		"react": "catalog:",
		"react-native": "catalog:",
		"react-native-gesture-handler": "catalog:react-native-gesture-handler-2-32-0",
		"react-native-reanimated": "catalog:",
		"react-native-safe-area-context": "catalog:react-native-safe-area-context-5-8-0",
		"react-native-worklets": "catalog:",
		"react-test-renderer": "catalog:",
		"typescript": "catalog:typescript-7-0-2",
		"react-native-svg": "catalog:react-native-svg-15-15-5"
	},
	"dependencies": {
		"@hugeicons/core-free-icons": "catalog:hugeicons-core-free-icons-4-3-0",
		"@hugeicons/react-native": "catalog:hugeicons-react-native-1-0-16"
	}
}
