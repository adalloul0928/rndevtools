{
	"name": "@pumpd/devtools",
	"version": "0.1.0",
	"private": true,
	"description": "Private, extensible on-device diagnostics for Expo and React Native",
	"license": "UNLICENSED",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./plugins": "./src/plugins/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"lint": "biome check src",
		"typecheck": "tsc --noEmit",
		"test:run": "jest --runInBand",
		"test:coverage": "jest --runInBand --coverage"
	},
	"peerDependencies": {
		"@expo/ui": ">=57 <58",
		"@tanstack/react-query": ">=5 <6",
		"expo": ">=57 <58",
		"react": ">=19 <20",
		"react-native": ">=0.86 <0.87",
		"react-native-gesture-handler": ">=2.16 <3",
		"react-native-reanimated": ">=4 <5",
		"react-native-safe-area-context": ">=5 <6",
		"react-native-worklets": ">=0.10 <1"
	},
	"peerDependenciesMeta": {
		"@tanstack/react-query": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@expo/ui": "57.0.11",
		"@tanstack/react-query": "5.101.4",
		"@testing-library/react-native": "13.3.3",
		"@types/jest": "^29",
		"@types/react": "19.2.18",
		"expo": "57.0.13",
		"jest": "^29",
		"jest-expo": "57.0.4",
		"react": "19.2.3",
		"react-native": "0.86.2",
		"react-native-gesture-handler": "2.32.0",
		"react-native-reanimated": "4.5.3",
		"react-native-safe-area-context": "5.8.0",
		"react-native-worklets": "0.10.1",
		"react-test-renderer": "19.2.3",
		"typescript": "7.0.2"
	}
}
